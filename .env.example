# Base URL of the Kanak backend API (Django, see backend/README.md)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Public site URL used to build certificate verification and referral links
VITE_PUBLIC_SITE_URL=http://localhost:5173

# "true" shows the sandbox checkout controls. Must match the backend's
# PAYMENT_GATEWAY=sandbox; set to false when a real gateway is configured.
VITE_PAYMENT_SANDBOX=true
